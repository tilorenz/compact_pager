#: ../package/contents/ui/config/configAppearance.qml
msgid "Fixed font color:"
msgstr "Фиксированный цвет шрифта:"

#: ../package/contents/ui/config/configAppearance.qml
msgid "Font color:"
msgstr "Цвет шрифта:"

#: ../package/contents/ui/config/configAppearance.qml
msgid "Border"
msgstr "Границы"

#: ../package/contents/ui/config/configAppearance.qml
msgid "Show border:"
msgstr "Отображать границы:"

#: ../package/contents/ui/config/configAppearance.qml
msgid "Border color:"
msgstr "Цвет границ:"

#: ../package/contents/ui/config/configAppearance.qml
msgid "Same as font"
msgstr "Как у текста"

#: ../package/contents/ui/config/configAppearance.qml
msgid "Border thickness:"
msgstr "Толщина границ:"

