msgstr "Радиус скругления границ, %:"

#: ../package/contents/ui/config/configAppearance.qml
msgid "Background"
msgstr "Фоновый цвет"

#: ../package/contents/ui/config/configAppearance.qml
msgid "Fixed active background color:"
msgstr "Фиксированный цвет фона активных элементов:"

#: ../package/contents/ui/config/configAppearance.qml
msgid "Fixed inactive background color:"
msgstr "Фиксированный цвет фона неактивных элементов:"

#: ../package/contents/ui/config/configAppearance.qml
msgid "Fixed inactive background color without windows:"
msgstr "Фиксированный цвет фона неактивных элементов без окон:"

#: ../package/contents/ui/config/configAppearance.qml
msgid "Window Indicator"
msgstr "Индикатор окон"

#: ../package/contents/ui/config/configAppearance.qml
msgid "Show window indicator:"
msgstr "Отображать индикатор окон:"

#: ../package/contents/ui/config/configAppearance.qml
msgid "Window indicator border radius (%):"
msgstr "Радиус скругления индикатора окон, %:"

#: ../package/contents/ui/config/configGeneral.qml
msgid "Stay visible when there is only one virtual desktop"
msgstr "Отображать, когда есть только один рабочий стол"

#: ../package/contents/ui/config/configGeneral.qml
msgid "Enable dropping apps to move"
msgstr "Включить перетаскивание приложений для перемещения"

#: ../package/contents/ui/config/configGeneral.qml
msgid "Enable drag-and-dropping apps from the task manager to move them to other desktops"
msgstr "Включить перетаскивание приложений с панели задач для их перемещения на другие рабочие столы"

#: ../package/contents/ui/config/configGeneral.qml
msgid "Enable scrolling to change the active desktop"
msgstr "Включить прокрутку для переключения активного рабочего стола"

#: ../package/contents/ui/config/configGeneral.qml
msgid "Invert scroll direction"
msgstr "Обратное направление прокрутки"

#: ../package/contents/ui/config/configGeneral.qml
msgid "Navigation wraps around"
msgstr "Прокрутка без остановки"

#: ../package/contents/ui/config/configGeneral.qml
msgid "Only show windows from current Screen in pager"
msgstr "Отображать только окна рабочих столов с этого экрана"

#: ../package/contents/ui/config/configGeneral.qml
msgid "Hide desktops without any windows"
msgstr "Скрывать рабочие столы без открытых окон"

#: ../package/contents/ui/config/configGeneral.qml
msgid "What to show in box:"
msgstr "Отображать внутри элементов:"

#: ../package/contents/ui/config/configGeneral.qml
msgid "Show desktop numbers"
msgstr "Номера рабочих столов"

#: ../package/contents/ui/config/configGeneral.qml
msgid "Show desktop names"
msgstr "Названия рабочих столов"

#: ../package/contents/ui/config/configGeneral.qml
msgid "Show window icons"
msgstr "Значки окон"

#: ../package/contents/ui/config/configGeneral.qml
msgid "Layout:"
msgstr "Макет:"

#: ../package/contents/ui/config/configGeneral.qml
msgid "Adaptive"
msgstr "Адаптивный"

#: ../package/contents/ui/config/configGeneral.qml
msgid "Full"
msgstr "Полный"

#: ../package/contents/ui/config/configGeneral.qml
msgid "Compact"
msgstr "Компактный"

#: ../package/contents/ui/config/configGeneral.qml
msgid "<b>Adaptive</b>:<br>Switch the layout depending on available space.<br><br><b>Full</b>:<br>Always show full layout.<br><br><b>Compact</b>:<br>Always show compact layout."
msgstr "<b>Адаптивный</b>:<br>Переключение макета в зависимости от доступного места.<br><br><b>Полный</b>:<br>Всегда отображать полный макет.<br><br><b>Компактный</b>:<br>Всегда отображать компактный макет."

#: ../package/contents/ui/config/configGeneral.qml
msgid "Selecting current virtual desktop:"
msgstr "Выбор текущего рабочего стола:"

#: ../package/contents/ui/config/configGeneral.qml
msgid "Does nothing"
msgstr "Ничего не делает"

#: ../package/contents/ui/config/configGeneral.qml
msgid "Shows the desktop"
msgstr "Показывает рабочий стол"

#: ../package/contents/ui/config/configGeneral.qml
msgid "Shows overview"
msgstr "Открывает обзор окон"

#: ../package/contents/ui/config/configGeneral.qml
msgid ""
"Directly do selected action in compact layout\n"
"instead of expanding full layout"
msgstr ""
"В режиме компактного макета, выполнять установленное\n"
"действие сразу же вместо открытия полного макета"

#: ../package/contents/ui/main.qml
msgid "Add Virtual Desktop"
msgstr "Добавить рабочий стол"

#: ../package/contents/ui/main.qml
msgid "Remove Virtual Desktop"
msgstr "Удалить рабочий стол"

#: ../package/contents/ui/main.qml
msgid "Configure Virtual Desktops…"
msgstr "Настроить рабочие столы…"
